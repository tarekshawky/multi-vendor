// Vogue-Chic multi-vendor marketplace schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
  WRITER
}

enum StoryStatus {
  DRAFT
  PUBLISHED
}

enum CollectionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CARD
  COD
  WALLET
}

enum DiscountType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

enum PromoStatus {
  ACTIVE
  SCHEDULED
  EXPIRED
}

enum CampaignStatus {
  ACTIVE
  SCHEDULED
}

enum VipTier {
  STANDARD
  ELITE
  VIP
}

enum VendorStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  avatar       String?
  role         Role       @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  vendorProfile   VendorProfile?
  customerProfile CustomerProfile?

  favorites          Favorite[]
  ordersAsCustomer   Order[]         @relation("CustomerOrders")
  sentMessages       Message[]       @relation("MessageSender")
  authoredNotes      Note[]          @relation("NoteAuthor")
  conversations      Conversation[]
  authoredStories    Story[]         @relation("StoryAuthor")

  @@index([role])
}

model VendorProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  brandName        String
  slug             String  @unique
  tagline          String?
  bio              String?
  logoImage        String?
  heroImage        String?
  coverImage       String?

  contactEmail String?
  phone        String?
  hqAddress    String?

  shippingPolicy String?
  bespokePolicy  String?

  orderNotificationsEnabled Boolean @default(true)
  marketingUpdatesEnabled   Boolean @default(true)
  passwordUpdatedAt         DateTime?

  currency String       @default("USD")
  status   VendorStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collections   Collection[]
  products      Product[]
  orders        Order[]        @relation("VendorOrders")
  conversations Conversation[]
  notes         Note[]
  promoCodes    PromoCode[]
  campaigns     Campaign[]

  @@index([slug])
  @@index([status])
}

model CustomerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  avatar            String?
  vipTier           VipTier  @default(STANDARD)
  bio               String?
  phone             String?
  location          String?
  sizingProfile     Json?
  aestheticTags     String[]
  favoredMaterials  String[]
  memberSince       DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vipTier])
}

model Collection {
  id                  String           @id @default(cuid())
  vendorId            String
  vendor              VendorProfile    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  name                String
  slug                String           @unique
  season              String?
  editorialDescription String?
  heroImage           String?
  campaignImages      String[]
  tags                String[]
  status              CollectionStatus @default(DRAFT)
  publishedAt         DateTime?

  revenue   Decimal @default(0) @db.Decimal(12, 2)
  itemCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([vendorId, status])
}

model Product {
  id           String      @id @default(cuid())
  vendorId     String
  vendor       VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  name        String
  slug        String   @unique
  description String?
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("USD")

  images    String[]
  colors    Json?
  materials String[]
  dimensions Json?
  sizes     String[]

  category          String?
  occasion          String[]
  sustainabilityTags String[]

  stock     Int @default(0)
  unitsSold Int @default(0)
  views     Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  favorites  Favorite[]
  orderItems OrderItem[]

  @@index([vendorId])
  @@index([collectionId])
  @@index([category])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  customerId  String
  customer    User        @relation("CustomerOrders", fields: [customerId], references: [id])
  vendorId    String
  vendor      VendorProfile @relation("VendorOrders", fields: [vendorId], references: [id])

  status OrderStatus @default(PENDING)

  subtotal Decimal @db.Decimal(12, 2)
  shipping Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)
  currency String  @default("USD")

  shippingAddress   Json?
  paymentMethod      PaymentMethod @default(CARD)
  paymentMethodLast4 String?

  placedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         OrderItem[]
  historyEvents OrderHistoryEvent[]
  conversations Conversation[]
  promoRedemption PromoRedemption?

  @@index([vendorId, status])
  @@index([customerId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  titleSnapshot String
  imageSnapshot String?
  color         String?
  size          String?
  qty           Int
  price         Decimal @db.Decimal(12, 2)

  @@index([orderId])
}

model OrderHistoryEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model Conversation {
  id           String        @id @default(cuid())
  customerId   String
  customer     User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendorId     String
  vendor       VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  orderId      String?
  order        Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)

  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  messages Message[]

  @@index([vendorId])
  @@index([customerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])

  body        String
  attachments String[]
  createdAt   DateTime @default(now())
  readAt      DateTime?

  @@index([conversationId])
}

model Note {
  id         String        @id @default(cuid())
  vendorId   String
  vendor     VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  customerId String
  authorId   String
  author     User          @relation("NoteAuthor", fields: [authorId], references: [id])

  body      String
  createdAt DateTime @default(now())

  @@index([vendorId, customerId])
}

model PromoCode {
  id          String       @id @default(cuid())
  vendorId    String
  vendor      VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  code         String       @unique
  title        String
  description  String?
  discountType DiscountType
  discountValue Decimal     @db.Decimal(12, 2)
  minOrderValue Decimal?    @db.Decimal(12, 2)
  usageLimit   Int?
  usageCount   Int          @default(0)
  status       PromoStatus  @default(SCHEDULED)
  validFrom    DateTime
  validUntil   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions PromoRedemption[]

  @@index([vendorId, status])
}

model PromoRedemption {
  id             String    @id @default(cuid())
  promoCodeId    String
  promoCode      PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  orderId        String    @unique
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId     String
  discountAmount Decimal   @db.Decimal(12, 2)
  createdAt      DateTime  @default(now())

  @@index([promoCodeId])
}

model Campaign {
  id       String        @id @default(cuid())
  vendorId String
  vendor   VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  title         String
  coverImage    String?
  status        CampaignStatus
  scheduledDate DateTime?
  reach         Int            @default(0)
  conversionRate Decimal       @default(0) @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
}

model Story {
  id       String @id @default(cuid())
  authorId String
  author   User   @relation("StoryAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  title      String
  slug       String      @unique
  excerpt    String?
  body       String
  coverImage String?
  status     StoryStatus @default(DRAFT)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([authorId])
}
